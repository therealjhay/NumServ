# ──────────────────────────────────────
# Database
# ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/numserve?schema=public"

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────
# Auth
# ──────────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
# RS256 keys for access tokens (required by auth middleware).
# Generate with:
#   ssh-keygen -t rsa -b 2048 -m PEM -f jwtRS256.key -N ""
#   openssl rsa -in jwtRS256.key -pubout -outform PEM -out jwtRS256.key.pub
# Then paste contents with \n for newlines, or set via env.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# ──────────────────────────────────────
# Encryption
# ──────────────────────────────────────
OTP_ENCRYPTION_KEY="change-me-to-32-byte-hex"
API_KEY_HASH_SALT="change-me"

# ──────────────────────────────────────
# Payment Providers
# ──────────────────────────────────────
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ──────────────────────────────────────
# SMS Providers
# ──────────────────────────────────────
SMSACTIVATE_API_KEY=""
FIVESIM_API_KEY=""
TEXTVERIFIED_API_KEY=""

# ──────────────────────────────────────
# Security
# ──────────────────────────────────────
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# ──────────────────────────────────────
# Email
# ──────────────────────────────────────
SENDGRID_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="noreply@numserve.io"

# ──────────────────────────────────────
# KYC (Phase 2)
# ──────────────────────────────────────
SMILE_IDENTITY_API_KEY=""
SMILE_IDENTITY_PARTNER_ID=""

# ──────────────────────────────────────
# App
# ──────────────────────────────────────
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"